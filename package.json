{
  "name": "ripcord",
  "version": "1.0.0",
  "description": "Fast, clean audio extractor for Spotify and YouTube powered by yt-dlp & FFmpeg",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint server.js src/ public/script.js",
    "check:syntax": "node --check server.js && node --check public/script.js && node -e \"require('fs').readdirSync('src').forEach(f => f.endsWith('.js') && require('child_process').execSync('node --check src/' + f))\"",
    "check:imports": "node scripts/check-imports.js",
    "check:icons": "pipx run --spec \"fonttools[brotli,woff]\" python scripts/check-icons.py"
  },
  "keywords": [
    "ripcord",
    "spotify-downloader",
    "youtube-to-mp3",
    "audio-extractor",
    "yt-dlp",
    "ffmpeg",
    "flac",
    "mp3"
  ],
  "author": "Webjuniors & Friends",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rusux64-bit/Ripcord.git"
  },
  "homepage": "https://ripcord.webjuniors.org",
  "dependencies": {
    "archiver": "^8.0.0",
    "axios": "^1.7.9",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "ffmpeg-static": "^5.2.0",
    "helmet": "^8.1.0",
    "node-id3": "^0.2.9"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}

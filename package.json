{
  "name": "ripcord",
  "version": "1.0.0",
  "description": "Fast, clean audio extractor for Spotify and YouTube powered by yt-dlp & FFmpeg",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:vendor": "esbuild scripts/mcu-entry.js --bundle --format=esm --minify --outfile=public/vendor/mcu.js"
  },
  "keywords": [
    "ripcord",
    "spotify-downloader",
    "youtube-to-mp3",
    "audio-extractor",
    "yt-dlp",
    "ffmpeg",
    "flac",
    "mp3"
  ],
  "author": "Webjuniors & Friends",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rusux64-bit/Ripcord.git"
  },
  "homepage": "https://ripcord.webjuniors.org",
  "dependencies": {
    "archiver": "^8.0.0",
    "axios": "^1.7.9",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  }
}

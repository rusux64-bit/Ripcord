# ==============================================================================
# Ripcord Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Networking
# ------------------------------------------------------------------------------

# HTTP port the server binds to (default: 5224, range: 1-65535)
PORT=5224

# Number of trusted reverse-proxy hops; set to 1 if behind Nginx/Caddy/Traefik,
# or higher if behind Cloudflare + reverse proxy. Defaults to 0 (untrusted).
TRUST_PROXY_HOPS=0

# Rate limiting window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum API requests allowed per client IP within the rate limit window (default: 120)
RATE_LIMIT_MAX=120

# ------------------------------------------------------------------------------
# Concurrency & Work Pools
# ------------------------------------------------------------------------------

# Maximum simultaneous yt-dlp download streams (default: 4, range: 1-8)
DOWNLOAD_CONCURRENCY=4

# Maximum simultaneous metadata fetch jobs (defaults to DOWNLOAD_CONCURRENCY, range: 1-8)
METADATA_CONCURRENCY=4

# Audio encoding workers for playlist packaging (defaults to CPU count up to 2, range: 1-8)
ENCODE_CONCURRENCY=2

# Concurrency for the Spotify background search-ahead pipeline (default: 6, range: 1-16)
SPOTIFY_SEARCH_CONCURRENCY=6

# Maximum pending download requests queued before returning 429 QUEUE_FULL (default: 8, range: 1-100)
MAX_QUEUED_DOWNLOADS=8

# ------------------------------------------------------------------------------
# Media Ceilings & Limits
# ------------------------------------------------------------------------------

# Maximum tracks accepted in a single playlist/album download request (default: 30, range: 1-100)
MAX_PLAYLIST_TRACKS=30

# Maximum payload size for playlist metadata output from yt-dlp in bytes (default: 2097152 = 2MB)
# MAX_PLAYLIST_OUTPUT_BYTES=2097152

# Maximum allowed size for album art / cover images in bytes (default: 5242880 = 5MB)
# MAX_COVER_BYTES=5242880

# Maximum raw downloaded audio stream size from yt-dlp in bytes (default: 104857600 = 100MB)
# MAX_DOWNLOAD_BYTES=104857600

# Maximum encoded single-track audio output size in bytes (default: 157286400 = 150MB)
# MAX_AUDIO_OUTPUT_BYTES=157286400

# Maximum track size within a ZIP archive in bytes (default: 41943040 = 40MB; FLAC/WAV use MAX_AUDIO_OUTPUT_BYTES)
# MAX_ZIP_TRACK_BYTES=41943040

# ------------------------------------------------------------------------------
# yt-dlp & Downloader Engine
# ------------------------------------------------------------------------------

# Number of parallel fragment downloads per track for yt-dlp (default: 4, range: 1-16)
YTDLP_CONCURRENT_FRAGMENTS=4

# Use aria2c external multi-connection downloader if available on the system PATH (default: false)
# YTDLP_USE_ARIA2C=true

# Temporary workspace directory for audio and cover art processing.
# Must be an absolute path. Recommended: tmpfs (e.g., /dev/shm/ripcord) for speed and disk preservation.
# Defaults to the operating system temporary directory (e.g., /tmp).
# WORK_DIR=/dev/shm/ripcord

# ------------------------------------------------------------------------------
# Spotify Match Cache
# ------------------------------------------------------------------------------

# File path for the persistent Spotify track id -> YouTube video id match cache
# SPOTIFY_MATCH_CACHE_FILE=cache/spotify_matches.json

# Maximum entries stored in the LRU match cache (default: 10000, range: 1-100000)
# SPOTIFY_MATCH_CACHE_MAX_SIZE=10000

# Time-to-live in days for cached Spotify track matches (default: 30, range: 1-365)
# SPOTIFY_MATCH_CACHE_TTL_DAYS=30

# ------------------------------------------------------------------------------
# Age-Gate Cookie Pool (Optional / Opt-In)
# ------------------------------------------------------------------------------

# Enable the secure multi-account cookie pool for age-restricted videos (default: off).
# Cookies are NEVER attached to initial downloads, searches, or metadata discovery.
# They are leased on-demand ONLY when a video explicitly returns an AGE_RESTRICTED failure.
AGE_GATE_COOKIES=off

# Directory containing Netscape-format cookie files for throwaway YouTube accounts (one .txt per account).
# YTDLP_AGE_COOKIES_DIR=/path/to/age_cookies
# Security Requirements:
# 1. Use dedicated throwaway Google accounts ONLY. NEVER use personal accounts.
# 2. Export cookies in Netscape HTTP format from a fresh incognito browser window.
# 3. NEVER reuse that session in a browser after exporting.
# 4. Enforce strict permissions: chmod 700 <dir> && chmod 600 <dir>/*.txt

# Comma-separated list of yt-dlp player clients for authenticated retries (default: web_embedded,web)
# YTDLP_AUTHED_CLIENTS=web_embedded,web

# ------------------------------------------------------------------------------
# Deprecated Options
# ------------------------------------------------------------------------------

# [DEPRECATED] Single fallback cookie file for age-gate retries if the pool is disabled.
# Will be removed in a future release. Use AGE_GATE_COOKIES=on with YTDLP_AGE_COOKIES_DIR instead.
# YTDLP_COOKIES_PATH=/path/to/cookies.txt

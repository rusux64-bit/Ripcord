# Bind address (127.0.0.1 for local, 0.0.0.0 for external)
BIND_ADDRESS=127.0.0.1

# Server port
PORT=5224

# Number of reverse proxy hops (set to 1 if behind Nginx/Caddy)
TRUST_PROXY_HOPS=0

# Rate limiting: max requests per window in milliseconds (15 mins = 900000)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120

# Max concurrent yt-dlp audio downloads
DOWNLOAD_CONCURRENCY=4

# Max concurrent metadata fetch requests
METADATA_CONCURRENCY=4

# Concurrent audio encoding workers for playlists
ENCODE_CONCURRENCY=2

# Concurrent Spotify candidate search-ahead queries
SPOTIFY_SEARCH_CONCURRENCY=6

# Max pending download requests queued before returning 429
MAX_QUEUED_DOWNLOADS=8

# Max tracks allowed per playlist or album
MAX_PLAYLIST_TRACKS=30

# Parallel yt-dlp download fragments per track
YTDLP_CONCURRENT_FRAGMENTS=4

# Temp workspace for audio processing (defaults to OS temp; e.g. /dev/shm/ripcord for RAM disk)
# WORK_DIR=/tmp

# Use aria2c for chunked downloads if installed
# YTDLP_USE_ARIA2C=true

# Persistent Spotify-to-YouTube track match cache
# SPOTIFY_MATCH_CACHE_FILE=cache/spotify_matches.json
# SPOTIFY_MATCH_CACHE_MAX_SIZE=10000
# SPOTIFY_MATCH_CACHE_TTL_DAYS=30

# Optional cookie pool for age-restricted videos (only used on age-gate retry)
AGE_GATE_COOKIES=off
# YTDLP_AGE_COOKIES_DIR=/path/to/cookies_folder
# YTDLP_AUTHED_CLIENTS=web_embedded,web
# COOKIE_GUARD_PER_ACCOUNT_HOURLY=6
# COOKIE_GUARD_PER_ACCOUNT_DAILY=30
# COOKIE_GUARD_GLOBAL_HOURLY=15
# COOKIE_GUARD_SOURCE_CACHE_MAX_MB=128

